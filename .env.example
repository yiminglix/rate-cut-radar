# Required for live FRED data. Leave empty to use built-in mock data locally.
FRED_API_KEY=

# Optional. Defaults to the official FRED API base URL.
FRED_API_BASE_URL=https://api.stlouisfed.org/fred

# Optional. How many months of history to fetch for every FRED series.
# V1.8 needs at least 14 months for Core PCE YoY trend checks.
FRED_OBSERVATION_MONTHS=24

# Optional. Server-side fetch cache duration in seconds. Default is 1 hour.
FRED_REVALIDATE_SECONDS=3600

# Optional. Retry transient FRED failures such as HTTP 429/500/502/503/504.
FRED_RETRY_ATTEMPTS=3
FRED_RETRY_DELAY_MS=750

# Optional. Daily FRED series older than this many calendar days are flagged as stale.
FRED_DAILY_STALE_DAYS=3
FRED_WEEKLY_STALE_DAYS=10
FRED_MONTHLY_STALE_DAYS=75

# Optional. Used to supplement Brent when the FRED Brent spot series is stale.
BRENT_MARKET_DATA_URL=https://s3.amazonaws.com/oilprice.com/widgets/oilprices/all/last.json

# Optional. Used to supplement official monthly PCE with daily Cleveland Fed nowcasts.
INFLATION_NOWCAST_URL=https://www.clevelandfed.org/indicators-and-data/inflation-nowcasting

# Optional. Used to supplement Treasury yields from the official U.S. Treasury curve.
TREASURY_DAILY_RATES_URL=https://home.treasury.gov/resource-center/data-chart-center/interest-rates/daily-treasury-rates.csv

# Optional. Used for asset trend and Fed Funds Futures market checks.
YAHOO_CHART_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart
